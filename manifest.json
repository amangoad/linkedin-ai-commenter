{
  "manifest_version": 3,
  "name": "LinkedIn AI Commenter",
  "version": "1.1.0",
  "description": "Generate natural LinkedIn engagement comments and place the selected comment into the LinkedIn comment box.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.linkedin.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "LinkedIn AI Commenter"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "settings.html"
}